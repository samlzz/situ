{
  "model": "opusplan",
  "showClearContextOnPlanAccept": true,
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make vet)",
      "Bash(make fmt)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run ./cmd/situ *)",
      "Bash(go mod tidy)",
      "Bash(gofmt *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(systemctl *)",
      "Bash(etckeeper *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(go get *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}